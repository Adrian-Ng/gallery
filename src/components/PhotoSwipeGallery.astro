---
import 'photoswipe/style.css';

const { images } = Astro.props;
---

<div class="gallery" id="gallery">
  {images.map((image: { src: string | URL | null | undefined; width: unknown; height: unknown; thumb: any; alt: any; }) => (
    <a
      href={image.src}
      data-pswp-width={image.width}
      data-pswp-height={image.height}
      data-lens={image.exif?.lens ?? ""}
      data-focal-length={image.exif?.focalLength ?? ""}
      data-aperture={image.exif?.aperture ?? ""}
      data-shutter-speed={image.exif?.shutterSpeed ?? ""}
      data-iso={image.exif?.iso ?? ""}
    >
      <img
        src={image.thumb ?? image.src}
        alt={image.alt ?? ""}
      />
    </a>
  ))}
</div>

<style>
.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1rem;
}

.gallery img {
  width: 100%;
  display: block;
}
</style>

<script type="module">
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  const metadataEl = document.getElementById("photo-metadata");

  const lightbox = new PhotoSwipeLightbox({
    gallery: "#gallery",
    children: "a",
    pswpModule: () => import("photoswipe"),
  });

  lightbox.on("change", () => {
    const slide = lightbox.pswp.currSlide;

    if (!slide?.data?.element) return;

    const el = slide.data.element;

    document.title =
    `${el.dataset.lens} | ${el.dataset.focalLength}`;

    const lens = el.dataset.lens;
    const focal = el.dataset.focalLength;
    const aperture = el.dataset.aperture;
    const shutter = el.dataset.shutterSpeed;
    const iso = el.dataset.iso;

    metadataEl.innerHTML = `
      <strong>${lens}</strong><br>
      ${focal} · ${aperture} · ${shutter} · ISO ${iso}
    `;
  });

  lightbox.on("openingAnimationStart", () => {
    metadataEl.style.display = "block";
  });

  lightbox.on("close", () => {
    metadataEl.style.display = "none";
  });

  lightbox.init();
</script>

<div id="photo-metadata"></div>

