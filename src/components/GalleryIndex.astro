---
const { galleries } = Astro.props;
---

<div class="grid">
  {Object.entries(galleries).map(([gallery, images]) => (
    <a href={`/${gallery}`} class="card">
      <img src={images[0].src} alt={gallery} />
      <h2>{gallery}</h2>
    </a>
  ))}
</div>

<style>
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
}

.card {
  text-decoration: none;
  color: inherit;
}

.card img {
  width: 100%;
  aspect-ratio: 3 / 2;
  object-fit: cover;
}

.card h2 {
  margin-top: 0.5rem;
}
</style>